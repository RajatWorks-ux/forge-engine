# FORGE AUTO API POOL
# Put any number of compatible OpenAI-style API credentials here.
# Empty slots are ignored. FORGE automatically selects provider/model/reasoning
# per task and load-balances parallel scene workers.

FORGE_API_SLOTS=20
# 0 = automatically use the total configured API concurrency (capped at 16).
FORGE_GLOBAL_CONCURRENCY=0
FORGE_SCENE_WORKERS=16
FORGE_STRUCTURED_ATTEMPTS=2
FORGE_API_RETRY_ATTEMPTS=2
FORGE_AUDIO_DURATION_TOLERANCE=0.05
FORGE_AUDIO_DURATION_ATTEMPTS=3
FORGE_API_TIMEOUT_MS=1800000
FORGE_REASONING_POLICY=auto

# Slot format:
# FORGE_API_01_KEY=...
# FORGE_API_01_PROVIDER=nvidia
# FORGE_API_01_BASE=https://integrate.api.nvidia.com/v1
# FORGE_API_01_MODEL=moonshotai/kimi-k3
# FORGE_API_01_CONCURRENCY=1
# FORGE_API_01_WEIGHT=1
# FORGE_API_01_REASONING_LEVELS=low,high,max
# FORGE_API_01_ENABLED=true

# Repeat the same pattern for 02 ... 20.
# PROVIDER defaults to nvidia and BASE defaults by known provider.
# For NVIDIA Kimi-K3 use low,high,max; if a provider does not support
# reasoning_effort, FORGE automatically retries that request without it.

# --- API SLOT PLACEHOLDERS ---
FORGE_API_01_KEY=
FORGE_API_01_PROVIDER=nvidia
FORGE_API_01_BASE=https://integrate.api.nvidia.com/v1
FORGE_API_01_MODEL=moonshotai/kimi-k3
FORGE_API_01_CONCURRENCY=1
FORGE_API_01_WEIGHT=1
FORGE_API_01_REASONING_LEVELS=low,high,max
FORGE_API_01_ENABLED=true

FORGE_API_02_KEY=
FORGE_API_02_PROVIDER=nvidia
FORGE_API_02_BASE=https://integrate.api.nvidia.com/v1
